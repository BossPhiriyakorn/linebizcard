# =============================================================================
# ตัวอย่างตัวแปรสภาพแวดล้อม (.env)
# =============================================================================
# 1. คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# 2. อย่า commit ไฟล์ .env ลง git (มีใน .gitignore แล้ว)
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
NODE_ENV=development
# URL หลักของแอป (ใช้ใน LINE callback, ลิงก์ในอีเมล ฯลฯ)
BASE_URL=https://your-domain.com
# รัน Production หลัง reverse proxy (Nginx): ใช้ 0.0.0.0 เพื่อฟังทุก interface
# HOST=0.0.0.0
# Redirect หลังชำระ (เช่น pay-by-qr) — แนะนำให้ตั้งบน Production = ค่าเดียวกับ BASE_URL
# FRONTEND_URL=https://your-domain.com

# =============================================================================
# LINE Configuration
# =============================================================================
# ค่ามาจาก LINE Developers Console → Channel ที่สร้าง
# ดูรายละเอียด: docs/ENV_CONFIGURATION_EXPLAINED.md
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://your-domain.com/api/auth/line/callback

# LIFF ID (จาก LINE Developers → LIFF)
LIFF_ID=
LIFF_LOGIN_ID=

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=line_flex_db
DB_USER=postgres
DB_PASSWORD=

# =============================================================================
# File Upload Configuration
# =============================================================================
UPLOAD_DIR=uploads/images
# ขนาดไฟล์สูงสุด (bytes) — 1073741824 = 1GB
MAX_FILE_SIZE=1073741824
# ขนาดไฟล์ที่ต้อง compress ใน frontend (MB) — ถ้าไฟล์ใหญ่กว่านี้จะ compress ก่อนอัปโหลด (default 2MB)
COMPRESS_THRESHOLD_MB=2
# นามสกุลรูปที่อนุญาต (ว่าง = ใช้ค่า default: jpg,jpeg,png,gif,webp,heic,heif,bmp,tiff,tif,ico,avif)
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,heic,heif,bmp,tiff,tif,ico,avif,dng

# =============================================================================
# Session/JWT Configuration
# =============================================================================
# สร้างค่าสุ่มยาวๆ (เช่น node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") — ห้ามใช้ค่าตัวอย่างใน production
# JWT_SECRET = สำหรับลูกค้า (LINE/LIFF)
JWT_SECRET=
# JWT_SECRET_CMS = สำหรับแอดมิน (CMS) — แยกจากลูกค้าเพื่อความปลอดภัย (ว่าง = ใช้ JWT_SECRET)
JWT_SECRET_CMS=
SESSION_SECRET=

# Encryption (PII ใน DB) — ต้องตั้งค่าเมื่อเปิดใช้การเข้ารหัส
# ENCRYPTION_KEY = 32 bytes hex (64 ตัวอักษร) หรือข้อความใดๆ (จะถูกแฮชเป็น key): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# OTP_PEPPER = ใช้ร่วมกับ SHA-256 แฮช OTP (ถ้าว่างจะไม่ใส่ pepper)
OTP_PEPPER=

# =============================================================================
# Email Configuration — ใช้ส่ง OTP และเมลจากระบบ
# =============================================================================
# ตัวเลือกที่ 1: Gmail SMTP → SMTP_HOST=smtp.gmail.com, SMTP_USER=อีเมล Gmail, SMTP_PASS=App Password
# ตัวเลือกที่ 2: Brevo → ใช้ค่าด้านล่าง (SMTP key จาก Brevo Dashboard → SMTP & API → SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# อีเมลและชื่อที่แสดงในหัวจดหมาย "จาก" (Brevo: ใช้อีเมลที่ยืนยันโดเมนแล้ว)
EMAIL_FROM=
EMAIL_FROM_NAME=Magic

# OTP Settings (รหัสยืนยันอีเมล)
OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_MINUTES=5
OTP_CODE_LENGTH=6
MAX_OTP_ATTEMPTS=5

# =============================================================================
# Payment Gateway (Stripe) — บัตรเครดิต/เดบิต ตัดเงินอัตโนมัติ
# =============================================================================
# ค่ามาจาก Stripe Dashboard → Developers → API keys
# ดูรายละเอียด: docs/PAYMENT_GATEWAY_SETUP.md
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
# สำหรับ Stripe Webhooks (ถ้าใช้)
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# =============================================================================
# LINE Pay — ชำระเงินผ่าน LINE Pay (รอเชื่อมต่อ API จริง)
# =============================================================================
# ค่ามาจาก LINE Pay Merchant (คนละ Channel กับ Messaging API/LIFF)
# ดูรายละเอียด: docs/LINE_PAY_SETUP.md (เมื่อมี)
# LINE_PAY_CHANNEL_ID=
# LINE_PAY_CHANNEL_SECRET=
# LINE_PAY_CONFIRM_URL=https://your-domain.com/api/line-pay/confirm
# LINE_PAY_CANCEL_URL=https://your-domain.com/payment-summary

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
NODE_ENV=development
# ไม่บังคับ: ค่าเริ่มต้น 0.0.0.0 ให้ Cloudflare Tunnel/proxy เข้าถึงได้ (ลด 502)
# HOST=0.0.0.0
# ใส่โดเมนจริง เช่น จาก Cloudflare Tunnel หรือเซิร์ฟเวอร์ (ไม่มี slash ท้าย)
# เมื่อใช้ Cloudflare Tunnel ต้องให้ตรงกับ URL ที่ tunnel แสดง (เช่น https://xxx.trycloudflare.com) เพื่อแก้ 502 / Blocked cross-origin
BASE_URL=https://your-domain.trycloudflare.com
# ไม่บังคับ: ถ้า BASE_URL เป็นค่าอื่น แต่เข้าแอปผ่าน Tunnel ใส่ origin ของ tunnel ที่นี่ (คั่นด้วย comma ได้หลายค่า)
# ADDITIONAL_DEV_ORIGINS=https://projectors-bite-fisher-somehow.trycloudflare.com

# =============================================================================
# LINE Login Configuration
# =============================================================================
# ⚠️ ไม่ต้องแยก - ใช้ Channel เดียวกันสำหรับทั้ง Login และ Share
# ดูรายละเอียดเพิ่มเติม: docs/ENV_CONFIGURATION_EXPLAINED.md
LINE_CHANNEL_ID=2008995579
LINE_CHANNEL_SECRET=20e8d8760c532c16473a7ff4d5a72f14
# ต้องตรงกับ Callback URL ใน LINE Developers และต้องเป็น BASE_URL + /api/auth/line/callback
LINE_CALLBACK_URL=https://your-domain.trycloudflare.com/api/auth/line/callback
LIFF_ID=2008995579-bGPQiNTN
LIFF_LOGIN_ID=2008995579-Q8z3aCaS

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=line_flex_db
DB_USER=postgres
DB_PASSWORD=Boss112234

# =============================================================================
# File Upload Configuration
# =============================================================================
UPLOAD_DIR=uploads/images
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,heic,heif

# =============================================================================
# Session/JWT Configuration
# =============================================================================
JWT_SECRET=line-flex-builder-secret-key-2024
SESSION_SECRET=line-flex-builder-session-secret-2024

# =============================================================================
# Payment Gateway (บัตรเครดิต/เดบิต ตัดเงินอัตโนมัติ)
# =============================================================================
# ดูรายละเอียด: docs/PAYMENT_GATEWAY_SETUP.md
# เมื่อยังไม่เชื่อมต่อ ให้เว้นว่างหรือปิดไว้ ระบบจะแสดง "รอพัฒนาก่อน" ในฟอร์มบัตร
PAYMENT_GATEWAY_ENABLED=false
# ชื่อ provider เช่น omise, 2c2p, stripe (ใช้เมื่อ implement จริง)
PAYMENT_GATEWAY_PROVIDER=
# คีย์สาธารณะ — ใช้ฝั่ง frontend สำหรับสร้าง token จากบัตร (ไม่ส่งเลขบัตรมา backend)
PAYMENT_GATEWAY_PUBLIC_KEY=
# คีย์ลับ — ใช้ฝั่ง backend เท่านั้น ห้ามเปิดเผย
PAYMENT_GATEWAY_SECRET_KEY=
# รหัสร้านค้า (ถ้า provider ต้องการ)
PAYMENT_GATEWAY_MERCHANT_ID=
# Base URL ของ API (ถ้าไม่ใช้ default ของ provider)
# PAYMENT_GATEWAY_API_URL=https://api.omise.co

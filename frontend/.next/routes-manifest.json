{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/login",
      "destination": "/liff/login",
      "statusCode": 307,
      "regex": "^(?!/_next)/login(?:/)?$"
    },
    {
      "source": "/register",
      "destination": "/liff/login",
      "statusCode": 307,
      "regex": "^(?!/_next)/register(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/cms/users/[id]",
      "regex": "^/cms/users/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/cms/users/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/edit-card/[id]",

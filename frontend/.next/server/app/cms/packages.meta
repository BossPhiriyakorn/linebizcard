{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/cms/layout,_N_T_/cms/packages/layout,_N_T_/cms/packages/page,_N_T_/cms/packages"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/cms/packages/__PAGE__",
    "/cms/packages",
    "/cms",
    "/_index",
    "/_head"
  ]
}
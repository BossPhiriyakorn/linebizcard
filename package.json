{
  "name": "line-flex-builder",
  "version": "1.0.0",
  "description": "MagicBiz-Card - แพลตฟอร์มสร้างและแชร์นามบัตรดิจิทัลผ่าน LINE",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--no-deprecation node server.js",

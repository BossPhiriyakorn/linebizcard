    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "fs-extra": "^11.1.1",
    "heic-convert": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^16.1.6",
    "nodemailer": "^8.0.0",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1"
  },
  "nodemonConfig": {
    "ignore": [
      "frontend/**",
      "node_modules/**"
    ]
  }
}
